<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.investingbriefingbot.weekly</string>

    <key>WorkingDirectory</key>
    <string>@@REPO_ROOT@@</string>

    <key>ProgramArguments</key>
    <array>
        <string>/bin/sh</string>
        <string>-c</string>
        <string>/usr/bin/make weekly &amp;&amp; /usr/bin/make orders-report</string>
    </array>

    <key>StartCalendarInterval</key>
    <dict>
        <key>Weekday</key>
        <integer>1</integer>
        <key>Hour</key>
        <integer>7</integer>
        <key>Minute</key>
        <integer>10</integer>
    </dict>

    <key>StandardOutPath</key>
    <string>@@REPO_ROOT@@/apps/briefing/launchd/weekly.stdout.log</string>

    <key>StandardErrorPath</key>
    <string>@@REPO_ROOT@@/apps/briefing/launchd/weekly.stderr.log</string>

    <key>RunAtLoad</key>
    <false/>
</dict>
</plist>
