<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.gimsejun.investingbriefingbot.orders</string>

    <key>ProgramArguments</key>
    <array>
        <string>/usr/bin/make</string>
        <string>-C</string>
        <string>/Users/gimsejun/dev/InvestingBriefingBot</string>
        <string>orders</string>
    </array>

    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key>
        <integer>6</integer>
        <key>Minute</key>
        <integer>50</integer>
    </dict>

    <key>StandardOutPath</key>
    <string>/Users/gimsejun/dev/InvestingBriefingBot/apps/briefing/launchd/orders.stdout.log</string>

    <key>StandardErrorPath</key>
    <string>/Users/gimsejun/dev/InvestingBriefingBot/apps/briefing/launchd/orders.stderr.log</string>

    <key>RunAtLoad</key>
    <false/>
</dict>
</plist>
