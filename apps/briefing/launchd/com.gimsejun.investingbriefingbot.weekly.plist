<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.gimsejun.investingbriefingbot.weekly</string>

    <key>ProgramArguments</key>
    <array>
        <string>/bin/sh</string>
        <string>-c</string>
        <string>/usr/bin/make -C /Users/gimsejun/dev/InvestingBriefingBot weekly &amp;&amp; /usr/bin/make -C /Users/gimsejun/dev/InvestingBriefingBot trades-report</string>
    </array>

    <key>StartCalendarInterval</key>
    <dict>
        <key>Weekday</key>
        <integer>1</integer>
        <key>Hour</key>
        <integer>7</integer>
        <key>Minute</key>
        <integer>10</integer>
    </dict>

    <key>StandardOutPath</key>
    <string>/Users/gimsejun/dev/InvestingBriefingBot/apps/briefing/launchd/weekly.stdout.log</string>

    <key>StandardErrorPath</key>
    <string>/Users/gimsejun/dev/InvestingBriefingBot/apps/briefing/launchd/weekly.stderr.log</string>

    <key>RunAtLoad</key>
    <false/>
</dict>
</plist>
